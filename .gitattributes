* text=auto

# Unity YAML: merge as text, keep line endings stable
*.unity    text eol=lf merge=unityyamlmerge
*.prefab   text eol=lf merge=unityyamlmerge
*.mat      text eol=lf
*.meta     text eol=lf
*.asset    -text diff
*.lighting text eol=lf

# Binary assets
*.fbx binary
*.FBX binary
*.tif binary
*.png binary
*.jpg binary
*.exr binary
*.wav binary
*.mp3 binary
*.ogg binary
